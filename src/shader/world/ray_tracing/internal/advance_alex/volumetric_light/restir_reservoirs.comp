#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common/shared.hpp"
#include "common/constants.glsl"
#include "util/random.glsl"

#ifndef ADV_VOLUMETRIC_RESTIR_PASS
#    define ADV_VOLUMETRIC_RESTIR_PASS 0
#endif
#ifndef ADV_ENABLE_RESTIR
#    define ADV_ENABLE_RESTIR 0
#endif
#ifndef ADV_VOLUMETRIC_FOG_EMISSIVE_BLOCKS
#    define ADV_VOLUMETRIC_FOG_EMISSIVE_BLOCKS 0
#endif

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};

layout(set = 2, binding = 1) uniform LastWorldUniform {
    WorldUBO lastWorldUBO;
};

layout(set = 2, binding = 2) uniform SkyUniform {
    SkyUBO skyUBO;
};

layout(set = 3, binding = 5, r16f) uniform readonly image2D linearDepthImage;

#include "common/light.glsl"
#include "common/light_neighborhood.glsl"
#include "common/volumetric_restir_reservoir.glsl"

uvec3 volumetricRestirGridSize() {
    ivec2 fullResolution = imageSize(linearDepthImage);
    return volumetricRestirGridSizeFromFullResolution(fullResolution);
}

bool sampleVolumetricRestirLightSource(uint centerChunkIndex,
                                       inout uint seed,
                                       out ChunkPackedLight chunkLight,
                                       out uint sourceChunkIndex,
                                       out uint sourceLightIndex,
                                       out float proposalPdf) {
    sourceChunkIndex = ADV_INVALID_AREA_LIGHT_SOURCE_INDEX;
    sourceLightIndex = ADV_INVALID_AREA_LIGHT_SOURCE_INDEX;
    proposalPdf = 0.0;

    ChunkLightNeighborhood neighborhood = chunkLightNeighborhoods[centerChunkIndex];
    float chunkProbability = 0.0;
    int neighborIndex = sampleChunkLightNeighborhoodEntry(neighborhood, rand(seed), rand(seed), chunkProbability);
    if (neighborIndex < 0 || !(chunkProbability > 1e-8)) { return false; }

    sourceChunkIndex = neighborhood.entries[neighborIndex].chunkIndex;
    ChunkLightData sampledChunk = chunkPackedData[sourceChunkIndex];
    if (!chunkPackedDataHasLights(sampledChunk)) { return false; }

    ChunkPackedLightBuffer lightBuffer = ChunkPackedLightBuffer(sampledChunk.lightBufferAddress);
    float scaledLightIndex = clamp(rand(seed), 0.0, ADV_UNIT_OPEN_UPPER_BOUND) * float(sampledChunk.lightCount);
    sourceLightIndex = min(uint(floor(scaledLightIndex)), sampledChunk.lightCount - 1u);
    chunkLight = lightBuffer.lights[sourceLightIndex];

    vec3 p0 = chunkLight.p0Area.xyz;
    vec3 p1 = chunkLight.p1.xyz;
    vec3 p2 = chunkLight.p2.xyz;
    vec3 p3 = chunkLight.p3.xyz;
    float totalArea =
        max(volumetricRestirTriangleArea(p0, p1, p2) + volumetricRestirTriangleArea(p0, p2, p3), chunkLight.p0Area.w);
    if (!(totalArea > 1e-8)) { return false; }

    proposalPdf = chunkProbability * (1.0 / float(sampledChunk.lightCount)) * (1.0 / totalArea);
    return proposalPdf > 1e-8;
}

void runInitialSampling(uvec3 coord, uvec3 gridSize) {
    ivec2 fullResolution = imageSize(linearDepthImage);
    vec3 scenePosition = volumetricRestirCellCenterScenePosition(coord, gridSize, fullResolution);
    vec3 viewDir = volumetricRestirSafeNormalize(scenePosition, vec3(0.0, 0.0, -1.0));

    uint centerChunkIndex = ADV_INVALID_AREA_LIGHT_SOURCE_INDEX;
    if (!volumetricRestirTryGetNeighborhoodIndex(scenePosition, centerChunkIndex)) {
        storeVolumetricRestirCandidate(coord, gridSize, makeEmptyVolumetricRestirReservoir());
        return;
    }

    VolumetricRestirRisState ris = makeVolumetricRestirRisState();
    uint baseSeed = xxhash32(uvec3(coord.x, coord.y, worldUBO.seed ^ 0xA511E9B3u));
    uint seed = xxhash32(uvec3(baseSeed, coord.z, 0xA511E9B3u));
    uint sampleCount = max(uint(ADV_VOLUMETRIC_RESTIR_INITIAL_SAMPLES), 1u);

    for (uint i = 0u; i < sampleCount; ++i) {
        ChunkPackedLight chunkLight;
        uint sourceChunkIndex;
        uint sourceLightIndex;
        float proposalPdf;
        if (!sampleVolumetricRestirLightSource(centerChunkIndex, seed, chunkLight, sourceChunkIndex, sourceLightIndex,
                                               proposalPdf)) {
            continue;
        }

        VolumetricRestirSample lightSample = volumetricRestirSampleFromChunkLight(chunkLight, sourceChunkIndex,
                                                                                  sourceLightIndex,
                                                                                  vec2(rand(seed), rand(seed)), rand(seed));
        vec3 dirToLight;
        float dist;
        lightSample.targetFunction = volumetricRestirTargetFunction(scenePosition, viewDir, lightSample.point,
                                                                    lightSample.normal, lightSample.emission, dirToLight,
                                                                    dist);
        if (!(lightSample.targetFunction > 1e-8)) { continue; }

        lightSample.contributionWeight = 1.0;
        lightSample.M = 1.0;
        lightSample.valid = true;
        float risWeight = lightSample.targetFunction / max(proposalPdf, 1e-8);
        volumetricRestirRisAddSample(ris, lightSample, risWeight, seed);
    }

    VolumetricRestirSample reservoir = volumetricRestirReservoirFromRis(ris, float(sampleCount));
    storeVolumetricRestirCandidate(coord, gridSize, encodeVolumetricRestirReservoir(reservoir));
}

void mergeReservoirAtQuery(inout VolumetricRestirRisState ris,
                           VolumetricRestirSample lightSample,
                           vec3 scenePosition,
                           vec3 viewDir,
                           inout float sampleCountSum,
                           inout uint seed,
                           bool strictSourceValidation) {
    bool sourceValid =
        strictSourceValidation ? volumetricRestirSourceExists(lightSample) : volumetricRestirSourceAddressable(lightSample);
    if (!sourceValid) { return; }

    vec3 dirToLight;
    float dist;
    lightSample.targetFunction = volumetricRestirTargetFunction(scenePosition, viewDir, lightSample.point,
                                                                lightSample.normal, lightSample.emission, dirToLight,
                                                                dist);
    if (!(lightSample.targetFunction > 1e-8)) { return; }

    float mergeCount = min(max(lightSample.M, 0.0), float(ADV_VOLUMETRIC_RESTIR_M_CAP));
    if (!(mergeCount > 1e-8)) { return; }

    float weight = mergeCount * lightSample.targetFunction * lightSample.contributionWeight;
    lightSample.M = mergeCount;
    sampleCountSum += mergeCount;
    volumetricRestirRisAddSample(ris, lightSample, weight, seed);
}

void runSpatialTemporalReuse(uvec3 coord, uvec3 gridSize) {
    ivec2 fullResolution = imageSize(linearDepthImage);
    vec3 scenePosition = volumetricRestirCellCenterScenePosition(coord, gridSize, fullResolution);
    vec3 viewDir = volumetricRestirSafeNormalize(scenePosition, vec3(0.0, 0.0, -1.0));
    uint spatialPassSeedSalt = ADV_VOLUMETRIC_RESTIR_HISTORY_PING_INPUT ? 0x53A71A11u : 0xC4F82E4Du;
    uint baseSeed = xxhash32(uvec3(coord.x, coord.y, worldUBO.seed ^ spatialPassSeedSalt));
    uint seed = xxhash32(uvec3(baseSeed, coord.z, spatialPassSeedSalt));

    VolumetricRestirRisState ris = makeVolumetricRestirRisState();
    float sampleCountSum = 0.0;

    mergeReservoirAtQuery(ris, decodeVolumetricRestirReservoir(loadVolumetricRestirCandidate(coord, gridSize)),
                          scenePosition, viewDir, sampleCountSum, seed, false);

    if (ADV_VOLUMETRIC_RESTIR_TEMPORAL_REUSE != 0 && ADV_VOLUMETRIC_RESTIR_HISTORY_READY) {
        uvec3 prevCoord;
        if (volumetricRestirPreviousCoordFromScenePosition(scenePosition, gridSize, fullResolution, prevCoord)) {
            uint historyInputLayer = ADV_VOLUMETRIC_RESTIR_HISTORY_PING_INPUT ? 0u : 1u;
            VolumetricRestirSample prev =
                decodeVolumetricRestirReservoir(loadVolumetricRestirHistory(prevCoord, gridSize, historyInputLayer));
            prev.M = min(prev.M, max(float(ADV_VOLUMETRIC_RESTIR_M_CAP) * 0.75, 1.0));
            mergeReservoirAtQuery(ris, prev, scenePosition, viewDir, sampleCountSum, seed, true);
        }
    }

    for (uint i = 0u; i < uint(ADV_VOLUMETRIC_RESTIR_SPATIAL_SAMPLES); ++i) {
        int radius = max(int(ADV_VOLUMETRIC_RESTIR_SPATIAL_RADIUS), 1);
        ivec3 offset = ivec3(int(floor(rand(seed) * float(radius * 2 + 1))) - radius,
                             int(floor(rand(seed) * float(radius * 2 + 1))) - radius,
                             int(floor(rand(seed) * float(radius * 2 + 1))) - radius);
        ivec3 donorCoordI = clamp(ivec3(coord) + offset, ivec3(0), ivec3(gridSize) - ivec3(1));
        uvec3 donorCoord = uvec3(donorCoordI);
        VolumetricRestirSample donor =
            decodeVolumetricRestirReservoir(loadVolumetricRestirCandidate(donorCoord, gridSize));
        mergeReservoirAtQuery(ris, donor, scenePosition, viewDir, sampleCountSum, seed, false);
    }

    VolumetricRestirSample merged = volumetricRestirReservoirFromRis(ris, min(sampleCountSum, float(ADV_VOLUMETRIC_RESTIR_M_CAP)));
    VolumetricRestirReservoir encoded = encodeVolumetricRestirReservoir(merged);
    storeVolumetricRestirCurrent(coord, gridSize, encoded);
    storeVolumetricRestirHistory(coord, gridSize, ADV_VOLUMETRIC_RESTIR_HISTORY_PING_INPUT ? 1u : 0u, encoded);
}

void main() {
    uvec3 coord = gl_GlobalInvocationID.xyz;
    uvec3 gridSize = volumetricRestirGridSize();
    if (any(greaterThanEqual(coord, gridSize))) { return; }

    if (ADV_ENABLE_RESTIR == 0 || ADV_VOLUMETRIC_FOG_EMISSIVE_BLOCKS == 0) {
        VolumetricRestirReservoir emptyReservoir = makeEmptyVolumetricRestirReservoir();
        storeVolumetricRestirCandidate(coord, gridSize, emptyReservoir);
        storeVolumetricRestirCurrent(coord, gridSize, emptyReservoir);
        storeVolumetricRestirHistory(coord, gridSize, ADV_VOLUMETRIC_RESTIR_HISTORY_PING_INPUT ? 1u : 0u,
                                     emptyReservoir);
        return;
    }

#if ADV_VOLUMETRIC_RESTIR_PASS == 0
    runInitialSampling(coord, gridSize);
#else
    runSpatialTemporalReuse(coord, gridSize);
#endif
}
