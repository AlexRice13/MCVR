#version 460
#ifndef ADV_VOLUMETRIC_LIGHT_INLINE_RAY_QUERY
#    define ADV_VOLUMETRIC_LIGHT_INLINE_RAY_QUERY 1
#endif
#extension GL_EXT_ray_tracing : require
#if ADV_VOLUMETRIC_LIGHT_INLINE_RAY_QUERY
#    extension GL_EXT_ray_query : require
#endif
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common/shared.hpp"
#include "common/constants.glsl"
#include "common/first_hit_state.glsl"
#define ADV_RUNTIME_PRIMARY_SECONDARY_READONLY 1
#include "common/runtime_primary_secondary_arrays.glsl"
#undef ADV_RUNTIME_PRIMARY_SECONDARY_READONLY
#include "util/random.glsl"
#include "util/ray.glsl"
#include "util/util.glsl"

#ifndef ADV_VOLUMETRIC_LIGHT_MAX_STEPS
#    ifdef ADV_VOLUMETRIC_LIGHT_SAMPLES
#        define ADV_VOLUMETRIC_LIGHT_MAX_STEPS ADV_VOLUMETRIC_LIGHT_SAMPLES
#    else
#        define ADV_VOLUMETRIC_LIGHT_MAX_STEPS 16
#    endif
#endif
#ifndef ADV_VOLUMETRIC_LIGHT_DOWNSAMPLE_FACTOR
#    define ADV_VOLUMETRIC_LIGHT_DOWNSAMPLE_FACTOR 2
#endif
#ifndef ADV_VOLUMETRIC_LIGHT_SCATTERING_STRENGTH
#    define ADV_VOLUMETRIC_LIGHT_SCATTERING_STRENGTH 2.75
#endif
#ifndef ADV_VOLUMETRIC_LIGHT_MAX_DISTANCE
#    define ADV_VOLUMETRIC_LIGHT_MAX_DISTANCE 128.0
#endif
#ifndef ADV_VOLUMETRIC_LIGHT_NEAR_STEP_SIZE
#    define ADV_VOLUMETRIC_LIGHT_NEAR_STEP_SIZE 1.75
#endif
#ifndef ADV_VOLUMETRIC_LIGHT_FAR_STEP_SIZE
#    define ADV_VOLUMETRIC_LIGHT_FAR_STEP_SIZE 5.0
#endif
#ifndef ADV_VOLUMETRIC_LIGHT_LUMINANCE_LIMIT
#    define ADV_VOLUMETRIC_LIGHT_LUMINANCE_LIMIT 0.75
#endif
#ifndef ADV_DIRECT_LIGHT_STRENGTH
#    define ADV_DIRECT_LIGHT_STRENGTH 1.0
#endif
#ifndef ADV_EMISSIVE_VOLUME_LIGHT_STRENGTH
#    define ADV_EMISSIVE_VOLUME_LIGHT_STRENGTH 0.08
#endif
#ifndef ADV_VOLUMETRIC_FOG_EMISSIVE_BLOCKS
#    define ADV_VOLUMETRIC_FOG_EMISSIVE_BLOCKS 0
#endif

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};

layout(set = 2, binding = 2) uniform SkyUniform {
    SkyUBO skyUBO;
};

layout(set = 3, binding = 5, r16f) uniform readonly image2D linearDepthImage;
layout(set = 5, binding = 0) uniform sampler2D transLUT;
layout(set = 5, binding = 2) uniform samplerCube skyFull;
layout(set = 5, binding = 18, rgba16f) uniform image2D volumetricLightRawImage;

layout(location = 1) rayPayloadEXT ShadowRay shadowRay;

#include "common/celestial.glsl"
#include "common/alex_blocky_cloud_shadow.glsl"
#include "common/light.glsl"
#include "common/light_neighborhood.glsl"

bool finiteFloat(float value) {
    return !isnan(value) && !isinf(value);
}

bool finiteVec3(vec3 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

float luminance(vec3 value) {
    return dot(value, vec3(0.2126, 0.7152, 0.0722));
}

vec3 safeNormalize(vec3 value, vec3 fallback) {
    float len2 = dot(value, value);
    if (!finiteFloat(len2) || len2 <= 1e-12) { return fallback; }
    return value * inversesqrt(len2);
}

void buildCameraRay(ivec2 pixel, ivec2 fullResolution, out vec3 origin, out vec3 direction) {
    vec2 pixelCenter = vec2(pixel) + vec2(0.5) + worldUBO.cameraJitter;
    vec2 ndc = pixelCenter / vec2(fullResolution) * 2.0 - 1.0;
    vec4 nearPoint = vec4(ndc, 0.0, 1.0);
    vec4 viewNear = worldUBO.cameraProjMatInv * nearPoint;
    viewNear /= viewNear.w;

    origin = vec3(worldUBO.cameraEffectedViewMatInv * vec4(0.0, 0.0, 0.0, 1.0));
    direction = safeNormalize(vec3(worldUBO.cameraEffectedViewMatInv * vec4(viewNear.xyz, 0.0)),
                              vec3(0.0, 0.0, -1.0));
}

float rayDistanceFromViewDepth(float viewDepth, vec3 direction) {
    float viewDepthPerWorldDistance = -(mat3(worldUBO.cameraEffectedViewMat) * direction).z;
    if (!finiteFloat(viewDepth) || viewDepth >= INF_DISTANCE || abs(viewDepthPerWorldDistance) <= 1e-6) {
        return INF_DISTANCE;
    }
    return max(viewDepth / viewDepthPerWorldDistance, 0.0);
}

float henyeyGreenstein(float cosTheta, float g) {
    float gg = g * g;
    float denom = max(1.0 + gg - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - gg) * INV_4_PI / (denom * sqrt(denom));
}

vec3 applySampledLightChroma(vec3 lightRadiance, vec3 lightDir) {
    float lightLum = luminance(max(lightRadiance, vec3(0.0)));
    vec3 sampledRadiance = max(texture(skyFull, lightDir).rgb, vec3(0.0));
    float sampledLum = luminance(sampledRadiance);
    if (!finiteFloat(lightLum) || !finiteFloat(sampledLum) || lightLum <= 1e-6 || sampledLum <= 1e-6) {
        return lightRadiance;
    }

    vec3 sampledChroma = sampledRadiance * (lightLum / sampledLum);
    return mix(lightRadiance, sampledChroma, 0.65);
}

#if ADV_VOLUMETRIC_LIGHT_INLINE_RAY_QUERY
vec2 inlineShadowTransmittanceUv(float planetRadius, float viewCos) {
    float u = clamp(viewCos * 0.5 + 0.5, 0.0, 1.0);
    float v = clamp((planetRadius - ADV_ATMOSPHERE_RG) / (ADV_ATMOSPHERE_RT - ADV_ATMOSPHERE_RG), 0.0, 1.0);
    return vec2(u, v);
}

vec3 inlineShadowSkyRadiance(vec3 rayOrigin) {
    vec3 sunDirection = celestialSunDirection();
    const float celestialFadeThreshold = 0.3;

    vec3 atmosphereCenter = vec3(0.0, -ADV_ATMOSPHERE_RG, 0.0);
    vec3 rayOriginPlanet = rayOrigin - atmosphereCenter;
    float planetRadius = length(rayOriginPlanet);
    vec3 planetUp = rayOriginPlanet / max(planetRadius, 1e-6);
    float sunUpDot = clamp(dot(planetUp, sunDirection), -1.0, 1.0);
    planetRadius = clamp(planetRadius, ADV_ATMOSPHERE_RG, ADV_ATMOSPHERE_RT);

    vec3 atmosphereTransmittance = sampleTexture(transLUT, inlineShadowTransmittanceUv(planetRadius, sunUpDot), false).rgb;
    float sunRadianceScale =
        sin(PI / (2.0 * celestialFadeThreshold) * min(max(sunDirection.y, 0.0), celestialFadeThreshold));
    float moonRadianceScale =
        sin(PI / (2.0 * celestialFadeThreshold) * min(max(-sunDirection.y, 0.0), celestialFadeThreshold));
    return ADV_SUN_RADIANCE * atmosphereTransmittance * sunRadianceScale + ADV_MOON_RADIANCE * moonRadianceScale;
}

float traceInlineShadowVisibility(vec3 rayOrigin, vec3 rayDir, float maxDistance) {
    rayQueryEXT query;
    uint shadowMask = WORLD_MASK | PLAYER_MASK;
    uint flags = gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT;
    rayQueryInitializeEXT(query, topLevelAS, flags, shadowMask, rayOrigin, 0.001, rayDir, max(maxDistance, 0.05));
    while (rayQueryProceedEXT(query)) {}
    return rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT ? 1.0 : 0.0;
}
#endif

vec3 sampleDirectionalLight(vec3 position, vec3 lightDir, bool insideBoat) {
#if ADV_VOLUMETRIC_LIGHT_INLINE_RAY_QUERY
    vec3 origin = position + lightDir * 0.02;
    float visibility = traceInlineShadowVisibility(origin, lightDir, 1000.0);
    vec3 radiance = applySampledLightChroma(inlineShadowSkyRadiance(origin) * visibility, lightDir) *
                    (1.0 - skyUBO.rainGradient);
#else
    shadowRay.radiance = vec3(0.0);
    shadowRay.throughput = vec3(1.0);
    shadowRay.insideBoat = insideBoat ? 1u : 0u;
    shadowRay.pad0 = 0u;

    uint shadowMask = WORLD_MASK | PLAYER_MASK;
    if (ADV_CLOUD_MODE == 1u) { shadowMask |= CLOUD_MASK; }
    vec3 origin = position + lightDir * 0.02;
    traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, shadowMask, 1, 1, 0, origin, 0.001, lightDir, 1000.0, 1);
    vec3 radiance = applySampledLightChroma(shadowRay.radiance, lightDir) * (1.0 - skyUBO.rainGradient);
#endif
    vec3 absolutePosition = position + vec3(worldUBO.cameraPos.xyz);
    float cloudVisibility = ADV_CLOUD_MODE == 2u ? alexBlockyCloudLightVisibility(absolutePosition, lightDir) : 1.0;
    return radiance * cloudVisibility;
}

float areaLightTriangleArea(vec3 a, vec3 b, vec3 c) {
    return 0.5 * length(cross(b - a, c - a));
}

vec3 sampleAreaLightTriangle(vec3 a, vec3 b, vec3 c, vec2 xi) {
    float sqrtXi = sqrt(clamp(xi.x, 0.0, 1.0));
    float bary0 = 1.0 - sqrtXi;
    float bary1 = xi.y * sqrtXi;
    float bary2 = 1.0 - bary0 - bary1;
    return a * bary0 + b * bary1 + c * bary2;
}

bool tryGetAreaLightNeighborhood(vec3 position, out uint centerChunkIndex) {
    centerChunkIndex = ADV_INVALID_AREA_LIGHT_SOURCE_INDEX;

    ivec3 sectionCoordinate = ivec3(floor((position + vec3(worldUBO.cameraPos.xyz)) / 16.0));
    int resolvedCenterChunkIndex = -1;
    ivec3 centerChunkOrigin = ivec3(0);
    if (!tryGetChunkIndexFromSectionCoordinate(sectionCoordinate, worldUBO, resolvedCenterChunkIndex, centerChunkOrigin)) {
        return false;
    }

    ChunkLightData centerChunk = chunkPackedData[resolvedCenterChunkIndex];
    if (!chunkPackedDataMatchesOrigin(centerChunk, centerChunkOrigin)) { return false; }

    centerChunkIndex = uint(resolvedCenterChunkIndex);
    return chunkLightNeighborhoodCount(chunkLightNeighborhoods[centerChunkIndex]) > 0u;
}

bool sampleAreaLightSource(uint centerChunkIndex,
                           inout uint seed,
                           out ChunkPackedLight chunkLight,
                           out float proposalPdf) {
    proposalPdf = 0.0;

    ChunkLightNeighborhood neighborhood = chunkLightNeighborhoods[centerChunkIndex];
    float chunkProbability = 0.0;
    int neighborIndex = sampleChunkLightNeighborhoodEntry(neighborhood, rand(seed), rand(seed), chunkProbability);
    if (neighborIndex < 0 || chunkProbability <= 1e-8) { return false; }

    int sampledChunkIndex = int(neighborhood.entries[neighborIndex].chunkIndex);
    ChunkLightData sampledChunk = chunkPackedData[sampledChunkIndex];
    if (!chunkPackedDataHasLights(sampledChunk)) { return false; }

    ChunkPackedLightBuffer lightBuffer = ChunkPackedLightBuffer(sampledChunk.lightBufferAddress);
    float scaledLightIndex = clamp(rand(seed), 0.0, 0.99999994) * float(sampledChunk.lightCount);
    uint lightIndex = min(uint(floor(scaledLightIndex)), sampledChunk.lightCount - 1u);
    chunkLight = lightBuffer.lights[lightIndex];

    vec3 p0 = chunkLight.p0Area.xyz;
    vec3 p1 = chunkLight.p1.xyz;
    vec3 p2 = chunkLight.p2.xyz;
    vec3 p3 = chunkLight.p3.xyz;
    float totalArea = max(areaLightTriangleArea(p0, p1, p2) + areaLightTriangleArea(p0, p2, p3), chunkLight.p0Area.w);
    if (totalArea <= 1e-8) { return false; }

    proposalPdf = chunkProbability * (1.0 / float(sampledChunk.lightCount)) * (1.0 / totalArea);
    return proposalPdf > 1e-8;
}

bool evaluateAreaLightCandidate(ChunkPackedLight chunkLight,
                                float proposalPdf,
                                vec3 position,
                                vec3 rayDir,
                                inout uint seed,
                                out vec3 contribution,
                                out float targetPdf,
                                out vec3 dirToLight,
                                out float dist) {
    contribution = vec3(0.0);
    targetPdf = 0.0;
    dirToLight = vec3(0.0);
    dist = 0.0;

    vec3 p0 = chunkLight.p0Area.xyz;
    vec3 p1 = chunkLight.p1.xyz;
    vec3 p2 = chunkLight.p2.xyz;
    vec3 p3 = chunkLight.p3.xyz;
    float area0 = areaLightTriangleArea(p0, p1, p2);
    float area1 = areaLightTriangleArea(p0, p2, p3);
    float totalArea = max(area0 + area1, chunkLight.p0Area.w);
    if (totalArea <= 1e-8 || proposalPdf <= 1e-8) { return false; }

    bool firstTriangle = rand(seed) * totalArea < area0;
    vec3 lightPoint;
    vec3 lightNormal;
    if (firstTriangle) {
        lightPoint = sampleAreaLightTriangle(p0, p1, p2, vec2(rand(seed), rand(seed)));
        lightNormal = safeNormalize(cross(p1 - p0, p2 - p0), chunkLight.normal.xyz);
    } else {
        lightPoint = sampleAreaLightTriangle(p0, p2, p3, vec2(rand(seed), rand(seed)));
        lightNormal = safeNormalize(cross(p2 - p0, p3 - p0), chunkLight.normal.xyz);
    }

    vec3 sceneLightPoint = lightPoint - vec3(worldUBO.cameraPos.xyz);
    vec3 toLight = sceneLightPoint - position;
    float dist2 = dot(toLight, toLight);
    if (!finiteFloat(dist2) || dist2 <= 1e-6) { return false; }

    dist = sqrt(dist2);
    dirToLight = toLight / dist;
    if (!finiteVec3(dirToLight)) { return false; }

    float lightNoL = max(dot(safeNormalize(lightNormal, vec3(0.0, 1.0, 0.0)), -dirToLight), 0.0);
    if (lightNoL <= 1e-5) { return false; }

    vec3 lightRadiance = max(chunkLight.radiance.rgb, vec3(0.0));
    contribution = ADV_DIRECT_LIGHT_STRENGTH * ADV_EMISSIVE_VOLUME_LIGHT_STRENGTH * lightRadiance * lightNoL /
                   max(dist2 * proposalPdf, 1e-6);
    if (!finiteVec3(contribution)) { return false; }

    targetPdf = max(max(contribution.r, contribution.g), contribution.b);
    return targetPdf > 1e-6;
}

float traceAreaLightVisibility(vec3 position, vec3 dirToLight, float dist, bool insideBoat) {
#if ADV_VOLUMETRIC_LIGHT_INLINE_RAY_QUERY
    return traceInlineShadowVisibility(position + dirToLight * 0.02, dirToLight, max(dist - 0.05, 0.05));
#else
    shadowRay.radiance = vec3(0.0);
    shadowRay.throughput = vec3(1.0);
    shadowRay.insideBoat = insideBoat ? 1u : 0u;
    shadowRay.pad0 = 1u;

    uint shadowMask = WORLD_MASK | PLAYER_MASK;
    if (ADV_CLOUD_MODE == 1u) { shadowMask |= CLOUD_MASK; }
    traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, shadowMask, 1, 1, 0, position + dirToLight * 0.02, 0.001, dirToLight,
                max(dist - 0.05, 0.05), 1);
    return clamp(max(shadowRay.radiance.r, max(shadowRay.radiance.g, shadowRay.radiance.b)), 0.0, 1.0);
#endif
}

vec3 sampleEmissiveVolumetricLight(vec3 position, vec3 rayDir, bool insideBoat, inout uint seed) {
    if (ADV_ENABLE_RESTIR == 0 || ADV_VOLUMETRIC_FOG_EMISSIVE_BLOCKS == 0) { return vec3(0.0); }

    uint centerChunkIndex = ADV_INVALID_AREA_LIGHT_SOURCE_INDEX;
    if (!tryGetAreaLightNeighborhood(position, centerChunkIndex)) { return vec3(0.0); }

    vec3 pickedContribution = vec3(0.0);
    vec3 pickedDir = vec3(0.0);
    float pickedDist = 0.0;
    float pickedPdf = 0.0;
    float weightSum = 0.0;

    const uint candidateCount = 2u;
    for (uint i = 0u; i < candidateCount; ++i) {
        ChunkPackedLight chunkLight;
        float proposalPdf = 0.0;
        if (!sampleAreaLightSource(centerChunkIndex, seed, chunkLight, proposalPdf)) { continue; }

        vec3 contribution;
        float targetPdf;
        vec3 dirToLight;
        float dist;
        if (!evaluateAreaLightCandidate(chunkLight, proposalPdf, position, rayDir, seed, contribution, targetPdf,
                                        dirToLight, dist)) {
            continue;
        }

        float nextWeightSum = weightSum + targetPdf;
        if (rand(seed) * nextWeightSum < targetPdf) {
            pickedContribution = contribution;
            pickedDir = dirToLight;
            pickedDist = dist;
            pickedPdf = targetPdf;
        }
        weightSum = nextWeightSum;
    }

    if (pickedPdf <= 1e-6 || weightSum <= 1e-6) { return vec3(0.0); }

    float visibility = traceAreaLightVisibility(position, pickedDir, pickedDist, insideBoat);
    if (visibility <= 1e-3) { return vec3(0.0); }

    return pickedContribution * visibility * (weightSum / (pickedPdf * float(candidateCount)));
}

void airMedium(float cosTheta, out vec3 sigmaS, out vec3 sigmaT) {
    float mieG = clamp(ADV_ATMOSPHERE_MIE_G * 0.35, -0.2, 0.35);
    float miePhase = min(henyeyGreenstein(cosTheta, mieG), 4.0);
    float fogPhaseFloor = INV_4_PI * 0.65;
    float balancedMiePhase = max(miePhase, fogPhaseFloor);
    float rPhase = 3.0 * INV_4_PI * 0.25 * (1.0 + cosTheta * cosTheta);
    float fogPhase = mix(INV_4_PI, balancedMiePhase, 0.35);
    float fogRange = max(worldUBO.fogEnd - worldUBO.fogStart, 1.0);
    float fogDensity = max(2.0 / fogRange, 0.0) * 0.02;

    vec3 betaR = ADV_ATMOSPHERE_BETA_R * 18.0;
    vec3 betaM = ADV_ATMOSPHERE_BETA_M * mix(18.0, 54.0, skyUBO.rainGradient);
    sigmaS = betaR * rPhase + betaM * balancedMiePhase + vec3(fogDensity * fogPhase);
    sigmaT = betaR + betaM * 1.15 + vec3(fogDensity);
}

float airDensityFade(float t) {
    float fogStart = max(worldUBO.fogStart, 0.0);
    float fogRange = max(worldUBO.fogEnd - worldUBO.fogStart, 1.0);
    float rampLength = clamp(fogRange * 0.08, 4.0, 24.0);
    float sunHeight = abs(celestialSunDirection().y);
    float baseDensity = mix(0.80, 0.50, smoothstep(0.05, 0.35, sunHeight));
    return mix(baseDensity, 1.0, smoothstep(fogStart, fogStart + rampLength, t));
}

vec3 segmentIntegral(vec3 sigmaT, vec3 segmentTransmittance, float stepLength) {
    return vec3(sigmaT.r > 1e-6 ? (1.0 - segmentTransmittance.r) / sigmaT.r : stepLength,
                sigmaT.g > 1e-6 ? (1.0 - segmentTransmittance.g) / sigmaT.g : stepLength,
                sigmaT.b > 1e-6 ? (1.0 - segmentTransmittance.b) / sigmaT.b : stepLength);
}

vec3 softClampRadiance(vec3 value) {
    float limit = max(ADV_VOLUMETRIC_LIGHT_LUMINANCE_LIMIT, 1e-4);
    float lum = luminance(max(value, vec3(0.0)));
    if (!finiteFloat(lum) || lum <= 1e-6) { return vec3(0.0); }

    float knee = limit * 0.25;
    if (lum <= knee) { return value; }

    float range = max(limit - knee, 1e-4);
    float compressedLum = min(knee + range * (1.0 - exp(-(lum - knee) / range)), limit);
    return value * (compressedLum / lum);
}

void storeEmpty(ivec2 pixel) {
    imageStore(volumetricLightRawImage, pixel, vec4(0.0));
}

int volumetricDownsampleFactor() {
    return max(int(ADV_VOLUMETRIC_LIGHT_DOWNSAMPLE_FACTOR), 1);
}

ivec2 selectFullResolutionOffset(ivec2 lowPixel, int downsampleFactor) {
    uint offsetSeed = xxhash32(uvec3(uint(lowPixel.x), uint(lowPixel.y), worldUBO.seed ^ 0x6A09E667u));
    uint factor = uint(max(downsampleFactor, 1));
    return ivec2(int(offsetSeed % factor), int((offsetSeed / factor) % factor));
}

float volumetricStepLength(float t, float endDistance) {
    float nearStep = max(ADV_VOLUMETRIC_LIGHT_NEAR_STEP_SIZE, 0.25);
    float farStep = max(ADV_VOLUMETRIC_LIGHT_FAR_STEP_SIZE, nearStep);

    float growStart = min(24.0, endDistance * 0.30);
    float growEnd = max(growStart + 8.0, endDistance * 0.75);
    float growth = smoothstep(growStart, growEnd, t);
    return mix(nearStep, farStep, growth);
}

bool loadVolumetricCandidate(ivec2 pixel, out float linearDepth, out uint firstHitFlags) {
    firstHitFlags = decodeFirstHitFlags(loadPrimaryRayStateLayer(pixel, 2).w);
    if (hasFirstHitFlag(firstHitFlags, ADV_FIRST_HIT_FLAG_SKIP_FOG)) {
        linearDepth = 0.0;
        return false;
    }

    if (hasFirstHitFlag(firstHitFlags, ADV_FIRST_HIT_FLAG_HIT_SKY)) {
        linearDepth = INF_DISTANCE;
        return true;
    }

    linearDepth = imageLoad(linearDepthImage, pixel).r;
    return finiteFloat(linearDepth) && linearDepth > 0.0 && linearDepth < INF_DISTANCE * 0.5;
}

void main() {
    ivec2 lowPixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 lowResolution = imageSize(volumetricLightRawImage);
    if (any(greaterThanEqual(lowPixel, lowResolution))) { return; }

    if (worldUBO.skyType != 1 || skyUBO.cameraSubmersionType == 0 || skyUBO.cameraSubmersionType == 2 ||
        skyUBO.hasBlindnessOrDarkness > 0) {
        storeEmpty(lowPixel);
        return;
    }

    ivec2 fullResolution = imageSize(linearDepthImage);
    int downsampleFactor = volumetricDownsampleFactor();
    uint seed = xxhash32(uvec3(uint(lowPixel.x), uint(lowPixel.y), worldUBO.seed ^ 0xBB67AE85u));
    ivec2 selectedOffset = selectFullResolutionOffset(lowPixel, downsampleFactor);
    ivec2 baseFullPixel = lowPixel * downsampleFactor;
    ivec2 fullPixel = min(baseFullPixel + selectedOffset, fullResolution - ivec2(1));
    float sampleLinearDepth;
    uint firstHitFlags;
    bool hasCandidate = loadVolumetricCandidate(fullPixel, sampleLinearDepth, firstHitFlags);

    if (!hasCandidate) {
        bool sawSky = false;
        float closestDepth = INF_DISTANCE;
        ivec2 closestPixel = fullPixel;
        uint closestFlags = 0u;

        for (int y = 0; y < downsampleFactor; ++y) {
            for (int x = 0; x < downsampleFactor; ++x) {
                ivec2 candidatePixel = min(baseFullPixel + ivec2(x, y), fullResolution - ivec2(1));
                float candidateDepth;
                uint candidateFlags;
                if (loadVolumetricCandidate(candidatePixel, candidateDepth, candidateFlags)) {
                    if (candidateDepth < closestDepth) {
                        closestDepth = candidateDepth;
                        closestPixel = candidatePixel;
                        closestFlags = candidateFlags;
                        hasCandidate = true;
                    }
                } else {
                    sawSky = sawSky || hasFirstHitFlag(candidateFlags, ADV_FIRST_HIT_FLAG_HIT_SKY);
                }
            }
        }

        if (!hasCandidate) {
            imageStore(volumetricLightRawImage, lowPixel, vec4(vec3(0.0), sawSky ? INF_DISTANCE : 0.0));
            return;
        }

        fullPixel = closestPixel;
        sampleLinearDepth = closestDepth;
        firstHitFlags = closestFlags;
    }

    vec3 origin;
    vec3 rayDir;
    buildCameraRay(fullPixel, fullResolution, origin, rayDir);

    float mediumMaxDistance = clamp(ADV_VOLUMETRIC_LIGHT_MAX_DISTANCE, 32.0, 320.0);
    float endDistance = rayDistanceFromViewDepth(sampleLinearDepth, rayDir);
    if (endDistance >= INF_DISTANCE) { endDistance = mediumMaxDistance; }
    endDistance = min(endDistance, mediumMaxDistance);

    if (!finiteFloat(endDistance) || endDistance <= 0.05) {
        storeEmpty(lowPixel);
        return;
    }

    vec3 lightDir = celestialSunDirection();
    if (lightDir.y < 0.0) { lightDir = -lightDir; }

    float cosTheta = clamp(dot(rayDir, lightDir), -1.0, 1.0);
    vec3 sigmaS;
    vec3 sigmaT;
    airMedium(cosTheta, sigmaS, sigmaT);

    vec3 transmittance = vec3(1.0);
    vec3 radiance = vec3(0.0);
    bool insideBoat = hasFirstHitFlag(firstHitFlags, ADV_FIRST_HIT_FLAG_INSIDE_BOAT);

    float marchT = 0.0;
    for (int i = 0; i < ADV_VOLUMETRIC_LIGHT_MAX_STEPS && marchT < endDistance; ++i) {
        float remainingDistance = endDistance - marchT;
        float baseStepLength = volumetricStepLength(marchT, endDistance);
        float stepLength = min(baseStepLength, remainingDistance);
        float jitter = clamp(0.5 + (rand(seed) - 0.5) * 0.70, 0.15, 0.85);
        float t = marchT + stepLength * jitter;
        vec3 position = origin + rayDir * t;
        vec3 lightRadiance = sampleDirectionalLight(position, lightDir, insideBoat);
        lightRadiance += sampleEmissiveVolumetricLight(position, rayDir, insideBoat, seed);

        float densityScale = airDensityFade(t);
        float shaftDistanceFade = 1.0 - smoothstep(mediumMaxDistance * 0.45, mediumMaxDistance, t);
        float scatteringStrength = max(ADV_VOLUMETRIC_LIGHT_SCATTERING_STRENGTH, 0.0);
        float extinctionScale = 0.45;
        vec3 localSigmaS = sigmaS * densityScale * scatteringStrength * shaftDistanceFade;
        vec3 localSigmaT = sigmaT * densityScale * extinctionScale;
        vec3 segmentTransmittance = exp(-localSigmaT * stepLength);
        vec3 segment = segmentIntegral(localSigmaT, segmentTransmittance, stepLength);
        radiance += transmittance * lightRadiance * localSigmaS * segment;
        transmittance *= segmentTransmittance;
        marchT += stepLength;

        if (max(transmittance.r, max(transmittance.g, transmittance.b)) < 1e-3) { break; }
    }

    if (!finiteVec3(radiance)) { radiance = vec3(0.0); }
    radiance = softClampRadiance(radiance);
    imageStore(volumetricLightRawImage, lowPixel, vec4(max(radiance, vec3(0.0)), sampleLinearDepth));
}
